{
    "name": "@onmyway133/xcode-mcp",
    "version": "1.0.2",
    "description": "MCP server for interacting with Xcode build and simulator tools",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "xcode-mcp": "dist/index.js"
    },
    "scripts": {
        "build": "bun build src/index.ts --outdir dist --target node --format esm --banner '#!/usr/bin/env node'",
        "prepublishOnly": "bun run build",
        "start": "node dist/index.js",
        "dev": "bun src/index.ts",
        "inspect": "bunx @modelcontextprotocol/inspector bun src/index.ts",
        "mcp:add": "claude mcp add xcode-mcp -- bun $PWD/src/index.ts",
        "mcp:remove": "claude mcp remove xcode-mcp",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\""
    },
    "keywords": [
        "mcp",
        "xcode",
        "simulator",
        "ios",
        "macos",
        "build",
        "notarize"
    ],
    "author": "Khoa Pham",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onmyway133/xcode-mcp.git"
    },
    "homepage": "https://github.com/onmyway133/xcode-mcp",
    "bugs": {
        "url": "https://github.com/onmyway133/xcode-mcp/issues"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.25.1",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@types/node": "^22.9.1",
        "eslint": "^9.15.0",
        "prettier": "^3.3.3",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.15.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
